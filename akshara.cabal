cabal-version: 3.4
name:          akshara
version:       0.1.0.0
synopsis:      A typed search calculus and its executable utility
license:       NONE
build-type:    Simple
tested-with:   GHC == 9.12.4

common warnings
  ghc-options:
    -Wall -Wcompat -Werror
    -Wincomplete-uni-patterns -Wincomplete-record-updates
    -Wmissing-export-lists -Wunused-imports -Wunused-top-binds
    -Wunused-local-binds -Wunused-matches
    -Wredundant-constraints -Wpartial-fields -Widentities

library
  import:             warnings
  default-language:   GHC2021
  default-extensions: GADTs
  hs-source-dirs:      src
  exposed-modules:
    Akshara.Syntax
    Akshara.Semantics
    Akshara.Transform
    Akshara.Predicate
    Akshara.Enumeration
    Akshara.Errors
    Akshara.Domain
    Akshara.Order
    Akshara.Result
    Akshara.Solver
    Akshara.Analysis.Cardinality
    Akshara.Analysis.Depth
    Akshara.Plan
    Akshara.Partition
    Runtime.Parallel
    Runtime.Errors
    Runtime.Checkpoint
    Runtime.Engine
    Verify.Class
    Verify.Errors
    Verify.Formats.SaltedSha256
    CLI.Command
    CLI.Example
    CLI.Render
  build-depends:
      base       >=4.18 && <5
    , async      >=2.2  && <3
    , crypton    >=0.34 && <1.1
    , memory     >=0.14 && <0.20
    , bytestring

executable akshara
  import:            warnings
  default-language:  GHC2021
  hs-source-dirs:     app
  main-is:            Main.hs
  build-depends:
      base
    , akshara
    , bytestring

test-suite spec
  import:            warnings
  default-language:  GHC2021
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  other-modules:
    Akshara.TestSupport
    Akshara.SemanticsSpec
    Akshara.TransformSpec
    Akshara.PredicateSpec
    Akshara.EnumerationSpec
    Akshara.DomainSpec
    Akshara.SolverSpec
    Akshara.AnalysisSpec
    Akshara.PlanSpec
    Akshara.PartitionSpec
    Runtime.ParallelSpec
    Runtime.CheckpointSpec
    Runtime.EngineSpec
    Verify.SaltedSha256Spec
    CLI.CommandSpec
    CLI.RenderSpec
  build-tool-depends: hspec-discover:hspec-discover
  build-depends:
      base
    , akshara
    , hspec
    , QuickCheck
    , bytestring
    , memory
    , crypton
